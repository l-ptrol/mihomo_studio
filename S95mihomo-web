#!/bin/sh

PROG=/opt/bin/mhstudio
PIDfile=/opt/var/run/mhstudio.pid

case "$1" in
  start)
    echo "Starting Mihomo Studio (Go)..."
    $PROG > /dev/null 2>&1 &
    echo $! > $PIDfile
    ;;
  stop)
    echo "Stopping Mihomo Studio..."
    if [ -f $PIDfile ]; then
        kill $(cat $PIDfile) 2>/dev/null || true
        rm $PIDfile
    fi
    # Запасной вариант если PID файл не сработал
    PID=$(ps | grep "mhstudio" | grep -v grep | awk '{print $1}')
    [ -n "$PID" ] && kill -9 $PID 2>/dev/null || true
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  update)
    $PROG -update
    ;;
  uninstall)
    $PROG -uninstall
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|update|uninstall}"
    exit 1
esac

exit 0